generator client {
  provider = "prisma-client-js"
 
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model leads {
  id                 Int        @id @default(autoincrement())
  contact_name       String     @db.VarChar(150)
  phone              String?    @db.VarChar(30)
  channel            String     @db.VarChar(20)
  message_type       String     @default("customer_lead") @db.VarChar(20)
  intent             String     @default("unclassified") @db.VarChar(30)
  status             String     @default("new") @db.VarChar(20)
  platform_thread_id String?    @db.VarChar(255)
  possible_duplicate Boolean    @default(false)
  assigned_to        Int?
  created_at         DateTime   @default(now()) @db.Timestamp(6)
  updated_at         DateTime   @default(now()) @db.Timestamp(6)
  users              users?     @relation(fields: [assigned_to], references: [id], onUpdate: NoAction)
  messages           messages[]
  notes              notes[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model messages {
  id          Int      @id @default(autoincrement())
  lead_id     Int
  body        String
  direction   String   @db.VarChar(10)
  received_at DateTime @default(now()) @db.Timestamp(6)
  leads       leads    @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model notes {
  id         Int      @id @default(autoincrement())
  lead_id    Int
  written_by Int
  content    String
  created_at DateTime @default(now()) @db.Timestamp(6)
  leads      leads    @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [written_by], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(100)
  email         String   @unique @db.VarChar(150)
  password_hash String   @db.VarChar(255)
  role          String   @default("staff") @db.VarChar(20)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  leads         leads[]
  notes         notes[]
}

model ingest_logs {
  id         Int      @id @default(autoincrement())
  payload    String
  error      String
  created_at DateTime @default(now())
}