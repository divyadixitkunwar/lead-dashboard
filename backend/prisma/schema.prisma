generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../ERD.svg"
}

model businesses {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(150)
  created_at DateTime @default(now()) @db.Timestamp(6)

  users             users[]
  leads             leads[]
  business_channels business_channels[]
}

model business_channels {
  id           Int      @id @default(autoincrement())
  business_id  Int
  platform     String   @db.VarChar(20)
  external_id  String   @db.VarChar(60)
  display_name String?  @db.VarChar(150)
  access_token String?  @db.Text
  created_at   DateTime @default(now()) @db.Timestamp(6)

  businesses businesses @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([platform, external_id])
}

model leads {
  id                 Int        @id @default(autoincrement())
  business_id        Int
  contact_name       String     @db.VarChar(150)
  phone              String?    @db.VarChar(30)
  channel            String     @db.VarChar(20)
  message_type       String     @default("customer_lead") @db.VarChar(20)
  intent             String     @default("unclassified") @db.VarChar(30)
  status             String     @default("new") @db.VarChar(20)
  platform_thread_id String?    @db.VarChar(255)
  possible_duplicate Boolean    @default(false)
  assigned_to        Int?
  created_at         DateTime   @default(now()) @db.Timestamp(6)
  updated_at         DateTime   @default(now()) @db.Timestamp(6)
  businesses         businesses @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users              users?     @relation(fields: [assigned_to], references: [id], onUpdate: NoAction)
  messages           messages[]
  notes              notes[]

  @@index([business_id])
}

model messages {
  id                  Int      @id @default(autoincrement())
  lead_id             Int
  body                String
  direction           String   @db.VarChar(10)
  received_at         DateTime @default(now()) @db.Timestamp(6)
  platform_message_id String?  @unique @db.VarChar(255)
  leads               leads    @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model notes {
  id         Int      @id @default(autoincrement())
  lead_id    Int
  written_by Int
  content    String
  created_at DateTime @default(now()) @db.Timestamp(6)
  leads      leads    @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [written_by], references: [id], onUpdate: NoAction)
}

model users {
  id                Int           @id @default(autoincrement())
  business_id       Int
  name              String        @db.VarChar(100)
  email             String        @unique @db.VarChar(150)
  password_hash     String?       @db.VarChar(255)
  role              String        @default("staff") @db.VarChar(20)
  email_verified_at DateTime?     @db.Timestamp(6)
  status            String        @default("active") @db.VarChar(20)
  // NEW — collected once at signup so the owner has something to search by
  // when adding this business as a Tester on the Meta app after approval.
  // Nullable so it doesn't break any existing row; new signups require it
  // at the application layer (see routes/auth.js), not the database layer.
  facebook_contact  String?       @db.VarChar(255)
  created_at        DateTime      @default(now()) @db.Timestamp(6)
  businesses        businesses    @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  leads             leads[]
  notes             notes[]
  auth_tokens       auth_tokens[]

  @@index([business_id])
}

model auth_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  type       String    @db.VarChar(20)
  token_hash String    @db.VarChar(255)
  expires_at DateTime  @db.Timestamp(6)
  used_at    DateTime? @db.Timestamp(6)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
}

model ingest_logs {
  id         Int      @id @default(autoincrement())
  payload    String
  error      String
  created_at DateTime @default(now())
}
